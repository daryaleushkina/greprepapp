<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Окно до Compose: фон — токен bg (Compose рисует остальное сам). Цвета здесь — те же значения, что в
         design/tokens; XML-ресурсы токены не генерируют, а без них окно мигало бы белым в тёмной теме. -->
    <style name="Theme.GrePrep" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/gp_bg</item>
    </style>

    <!-- Заставка Android 12+: знак на фоне bg, держится, пока читается сохранённый вход. -->
    <style name="Theme.GrePrep.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/gp_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.GrePrep</item>
    </style>
</resources>
