<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Отладочная сборка (project.yml). Отличие от Info.plist — http до своего Мака: локальный сервер. -->
<plist version="1.0">
<dict>
	<key>GPAPIBaseURL</key>
	<string>$(GP_API_BASE_URL)</string>
	<key>GPAppleSignInEnabled</key>
	<string>$(GP_APPLE_SIGN_IN)</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
