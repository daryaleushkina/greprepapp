# Настройки сервера (internal/config/config.go). Секреты — только в окружении, в репозитории — пусто.
# Локально: скопировать в server/.env (он в .gitignore) и заполнить.

# development | test | staging | production
APP_ENV=development
HTTP_ADDR=127.0.0.1:8090
DATABASE_URL=postgres://greprep:greprep@127.0.0.1:55432/greprep?sslmode=disable
# Коммит сборки — его отдаёт /api/health (ставит выкладка).
APP_VERSION=

# Токен бота: им проверяется подпись initData мини-аппа.
BOT_TOKEN=
INIT_DATA_MAX_AGE=24h

# Вход подменой (/api/auth/dev): локально, в e2e и на стенде. В production сервер с ним не стартует.
DEV_AUTH=1

SESSION_IDLE=720h
SESSION_ABSOLUTE=4320h

# Провайдеры входа по OpenID Connect. Пустой ISSUER — провайдер выключен.
TELEGRAM_OIDC_ISSUER=
TELEGRAM_OIDC_AUDIENCES=
TELEGRAM_OIDC_CLIENT_ID=
TELEGRAM_OIDC_CLIENT_SECRET=
TELEGRAM_OIDC_REDIRECT_URIS=

APPLE_OIDC_ISSUER=
APPLE_OIDC_AUDIENCES=
APPLE_OIDC_CLIENT_ID=
APPLE_OIDC_CLIENT_SECRET=
APPLE_OIDC_REDIRECT_URIS=

GOOGLE_OIDC_ISSUER=
GOOGLE_OIDC_AUDIENCES=
GOOGLE_OIDC_CLIENT_ID=
GOOGLE_OIDC_CLIENT_SECRET=
GOOGLE_OIDC_REDIRECT_URIS=
