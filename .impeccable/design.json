 "narrative": {
  "northStar": "Спокойная лента",
  "overview": "День подготовки — лента из трёх-четырёх шагов с видимым концом. В фокусе всегда один шаг: он освещён, остальное — тихие строки на фоне. Внутри шага — одна задача на экран и одна главная кнопка в одном месте. Стекло — слой управления; текст задания и разбор лежат на плотном. Система одна для мини-аппа, сайта и приложений на Swift и Kotlin, у каждой платформы — свои родные элементы управления.",
  "keyCharacteristics": [
   "Лента шагов с видимым концом — главный узнаваемый приём.",
   "Одно освещённое место на экране; всё прочее — тихо.",
   "Стекло только у управления и текущего шага; задание — на плотном.",
   "Светлая и тёмная тема на одних и тех же ролях цвета.",
   "Ошибка — спокойно: оранжевый и значок, без красной заливки."
  ],
  "rules": [
   {
    "name": "Правило метки",
    "body": "Цвет раздела — это метка: узел, короткая подпись, отметка верного ответа и свет сверху (не больше 22 % непрозрачности). Большими заливками цвета разделов не красим.",
    "section": "colors"
   },
   {
    "name": "Правило двух цветов ошибки",
    "body": "Верно — цвет раздела и галочка; неверно — --color-wrong (оранжевый) и крестик. Красного в интерфейсе нет.",
    "section": "colors"
   },
   {
    "name": "Правило официальных кнопок",
    "body": "Кнопки входа Telegram, Apple и Google — их официального вида и цвета; свои стили к ним не применяем.",
    "section": "colors"
   },
   {
    "name": "Правило без рубрик",
    "body": "Подписи-рубрики, которые и так понятны, не пишем. Слово на экране обязано помогать действию.",
    "section": "typography"
   },
   {
    "name": "Правило ёлочек",
    "body": "Русский текст — только «ёлочки»; английский — “…”.",
    "section": "typography"
   },
   {
    "name": "Правило одной задачи",
    "body": "Экран сессии — одна задача и одна главная кнопка в одном месте; конец сессии виден.",
    "section": "layout"
   },
   {
    "name": "Правило ширины по делу",
    "body": "Две колонки на компьютере — только когда это помогает задаче.",
    "section": "layout"
   },
   {
    "name": "Правило освещённого шага",
    "body": "Стеклянная карточка на экране одна — текущий шаг или главное действие.",
    "section": "elevation"
   },
   {
    "name": "Правило стекла для управления",
    "body": "Стекло — шапка, вкладки, переключатели, чипы, шторки и текущий шаг; задание и разбор — на плотном; не больше 3–4 стеклянных слоёв.",
    "section": "elevation"
   }
  ],
  "dos": [
   "Do показывать конец: «4 из 10», «На сегодня всё.», карта пяти частей пробника на старте и между секциями.",
   "Do держать одну главную кнопку на экране в одном и том же месте.",
   "Do раскрывать разбор в два уровня: вердикт и одна фраза → «Почему не …?», плюс RU/EN.",
   "Do брать цвета, размеры и шрифты только из токенов (--color-*, --space-*, --radius-*, --font-*).",
   "Do проверять контраст текста на стекле по худшему фону под ним (≥ 4,5 : 1)."
  ],
  "donts": [
   "Don't добавлять серии, очки, лиги, значки, красные счётчики и маскотов на экраны заданий.",
   "Don't писать подписи-рубрики и ставить стрелки у простых ссылок.",
   "Don't показывать этапы памяти и расписание повторений слов.",
   "Don't использовать в русском тексте кавычки-«лапки» — только «ёлочки».",
   "Don't заливать большие области цветом раздела и делать карточками всё подряд — карточка одна.",
   "Don't рисовать свои версии кнопок входа Telegram, Apple и Google.",
   "Don't прятать таймер пробника — он виден всегда."
  ]
 }
