#!/bin/sh
# Пуш в main с этой машины: гейт (scripts/hooks/gate — те же проверки, что в GitHub Actions) на том коммите,
# который уходит. Хуки включает .claude/hooks/session-git.sh в начале сессии Claude Code
# (или руками: git config core.hooksPath scripts/hooks).
#
# Деплоя отсюда пока нет: сервера ещё нет (docs/ROADMAP.md §2, часть 7). Когда появится — вливание в main
# выкладывает сначала на стенд, после зелёных автотестов на нём — в бой (PRODUCT.md, «Stack»).

sha=""
while read -r _local_ref local_sha remote_ref _remote_sha; do
  [ "$remote_ref" = "refs/heads/main" ] && sha="$local_sha"
done
[ -z "$sha" ] && exit 0
# Удаление ветки — проверять нечего.
[ "$sha" = "0000000000000000000000000000000000000000" ] && exit 0

cd "$(git rev-parse --show-toplevel)" || exit 1

# Гейт проверяет рабочую папку, поэтому она должна совпадать с тем, что пушим.
if [ "$sha" != "$(git rev-parse HEAD)" ]; then
  echo "pre-push: в main уходит не текущий HEAD — переключись на этот коммит (git switch), чтобы гейт проверил именно его" >&2
  exit 1
fi
dirty="$(git status --porcelain -- . ':!.claude' ':!.mcp.json' ':!.idea')"
if [ -n "$dirty" ]; then
  echo "pre-push: есть незакоммиченные изменения — гейт проверил бы не то, что в коммите:" >&2
  echo "$dirty" >&2
  echo "Закоммить или убери их (git stash -u)." >&2
  exit 1
fi

echo "pre-push: гейт для $sha…" >&2
if ! sh "$(dirname "$0")/gate"; then
  echo "pre-push: гейт красный — пуш отменён. Чинить код, а не обходить (--no-verify)." >&2
  exit 1
fi
exit 0
