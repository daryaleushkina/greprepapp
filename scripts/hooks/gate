#!/bin/sh
# Гейт перед продом — одни и те же проверки для хука pre-push и GitHub Actions, чтобы они не расходились.
# Каждая часть включается, когда она есть в репозитории (каркас собирается частями, docs/ROADMAP.md §2).
#
#   бэкенд (server/go.mod): сгенерированное свежее → go vet → golangci-lint → go test -race → порог покрытия;
#   приложение Apple (apps/apple/project.yml): gate-apple — только когда пуш задевает приложение, договор, токены,
#   сервер или гейт (apple-touched; база — GATE_BASE, её даёт pre-push; решение Даши 06.10.2026);
#   приложение Android (apps/android): gate-android — когда пуш задевает приложение, договор, токены или гейт
#   (android-touched), без эмулятора (решение Даши 06.10.2026);
#   веб (package.json): Node 24 → зависимости по lockfile → клиент API и токены свежие, контраст токенов → typecheck →
#   oxlint → vitest и порог покрытия (vitest.config.ts) → e2e (браузеры в Docker, compose.yaml) → сборка; при каждом
#   пуше (согласие Даши 07.10.2026).
#
# Порог покрытия — здесь, а правка этой папки — только с согласия Даши (.claude/hooks/protect-gates.mjs):
# CLAUDE.md, «Порог не опускать; подняли покрытие — поднять и порог».
# Запуск руками: sh scripts/hooks/gate

set -eu

# Покрытие ручного кода бэкенда, % (сгенерированное ogen и sqlc и помощники тестов не считаются).
GO_COVERAGE_MIN=93.0

hooks="$(cd "$(dirname "$0")" && pwd)"
root="$(git rev-parse --show-toplevel)"
cd "$root"
# При пуше из отдельной рабочей папки (git worktree) git отдаёт хуку GIT_DIR, и тогда git из подпапки
# (cd apps/apple && git status -- Packages/…) считает подпапку корнем: свежий клиент выглядел «новым файлом».
# Дальше git сам находит репозиторий по текущей папке.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE
ran=""
skipped=""

if [ -f server/go.mod ]; then
  ran="$ran бэкенд"
  echo "gate: бэкенд — сгенерированный код свежий?" >&2
  (cd server && go generate ./...)
  if [ -n "$(git status --porcelain -- server api)" ]; then
    git status --porcelain -- server api >&2
    echo "gate: код, сгенерированный из api/openapi.yaml и SQL, разошёлся с источником —" >&2
    echo "      cd server && go generate ./... и закоммитить результат" >&2
    exit 1
  fi

  echo "gate: бэкенд — go vet и golangci-lint" >&2
  (cd server && go vet ./...)
  lint="$(command -v golangci-lint || echo "$(go env GOPATH)/bin/golangci-lint")"
  if [ ! -x "$lint" ]; then
    echo "gate: нет golangci-lint — поставить: docs/HANDOFF.md, «Бэкенд»" >&2
    exit 1
  fi
  (cd server && "$lint" run ./...)

  # Интеграционные тесты идут против настоящего Postgres. В Actions его даёт сервис (TEST_DATABASE_URL уже
  # задан), локально — compose.yaml; нет Docker — гейт красный: непроверенное в прод не уходит.
  if [ -z "${TEST_DATABASE_URL:-}" ]; then
    echo "gate: поднимаю локальный Postgres (compose.yaml)…" >&2
    if ! docker compose up -d --wait postgres >&2; then
      echo "gate: Postgres не поднялся (запущен ли Docker?)" >&2
      exit 1
    fi
    TEST_DATABASE_URL="postgres://greprep:greprep@127.0.0.1:55432/greprep?sslmode=disable"
  fi
  export TEST_DATABASE_URL

  echo "gate: бэкенд — go test -race и покрытие ≥ ${GO_COVERAGE_MIN}%" >&2
  cover="$(mktemp)"
  trap 'rm -f "$cover" "$cover.own"' EXIT
  (cd server && go test -race -count=1 -coverpkg=./internal/... -coverprofile="$cover" ./...)
  grep -v -E '/internal/(api|db|oidctest|testdb)/' "$cover" > "$cover.own"
  total="$(cd server && go tool cover -func="$cover.own" | awk '/^total:/ { sub("%", "", $3); print $3 }')"
  if ! awk -v t="$total" -v m="$GO_COVERAGE_MIN" 'BEGIN { exit !(t + 0 >= m + 0) }'; then
    echo "gate: покрытие бэкенда ${total}% ниже порога ${GO_COVERAGE_MIN}% — дописать тесты, порог не опускать" >&2
    exit 1
  fi
  echo "gate: покрытие бэкенда ${total}%" >&2
fi

if [ -f apps/apple/project.yml ]; then
  if sh "$hooks/apple-touched" "${GATE_BASE:-}"; then
    ran="$ran Apple"
    sh "$hooks/gate-apple"
  else
    skipped="$skipped Apple"
    echo "gate: Apple — пропущен: в пуше нет правок приложения, договора, токенов, сервера и гейта" >&2
  fi
fi

if [ -f apps/android/settings.gradle.kts ]; then
  if sh "$hooks/android-touched" "${GATE_BASE:-}"; then
    ran="$ran Android"
    sh "$hooks/gate-android"
  else
    skipped="$skipped Android"
    echo "gate: Android — пропущен: в пуше нет правок приложения, договора, токенов и гейта" >&2
  fi
fi

if [ -f package.json ]; then
  ran="$ran веб"
  node_major="$(node -p 'process.versions.node.split(".")[0]' 2>/dev/null || echo нет)"
  if [ "$node_major" != "24" ]; then
    echo "gate: веб — нужен Node 24 (.node-version), сейчас: $node_major — fnm install 24 && fnm use 24" >&2
    exit 1
  fi
  echo "gate: веб — зависимости по lockfile" >&2
  pnpm install --frozen-lockfile --silent >&2

  echo "gate: веб — клиент API и токены свежие?" >&2
  pnpm --silent generate >/dev/null
  if [ -n "$(git status --porcelain -- packages/api-client)" ]; then
    git status --porcelain -- packages/api-client >&2
    echo "gate: клиент веба разошёлся с api/openapi.yaml — pnpm generate и закоммитить результат" >&2
    exit 1
  fi
  pnpm --silent --filter @greprep/tokens check >&2
  pnpm --silent --filter @greprep/tokens test >/dev/null

  echo "gate: веб — typecheck и oxlint" >&2
  pnpm --silent typecheck >&2
  pnpm --silent lint >&2

  echo "gate: веб — модульные тесты и компоненты, порог покрытия (vitest.config.ts)" >&2
  # Тесты компонентов идут в настоящем Chromium; есть — ничего не скачивается.
  pnpm --silent exec playwright install chromium >/dev/null
  pnpm --silent coverage >&2

  echo "gate: веб — сквозные тесты (стенд server/cmd/e2estack, браузеры в Docker)" >&2
  if ! docker compose --profile e2e up -d --wait postgres browsers >&2; then
    echo "gate: Postgres или браузеры e2e не поднялись (запущен ли Docker?)" >&2
    exit 1
  fi
  pnpm --silent e2e >&2

  echo "gate: веб — сборка" >&2
  pnpm --silent build >/dev/null
fi

if [ -n "$ran" ]; then
  echo "gate: зелёный —$ran" >&2
elif [ -n "$skipped" ]; then
  echo "gate: зелёный — проверять нечего (пропущено:$skipped)" >&2
else
  echo "gate: каркаса нет (ни server/go.mod, ни apps/apple, ни apps/android, ни package.json) — проверять нечего" >&2
fi
